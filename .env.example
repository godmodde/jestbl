# Скопируйте в .env.local и при необходимости поправьте.

# База (npm run db:up поднимает Postgres в Docker на этом порту)
DATABASE_URL=postgres://vidno:vidno@127.0.0.1:5433/vidno

# Видео surdo.media по прямым ссылкам. ТОЛЬКО для локального показа — в публичной сборке не задавать:
# разрешения правообладателя пока нет. Без переменной вместо видео показываются заглушки.
DEMO_VIDEOS=surdo

# Номер счётчика Яндекс Метрики. Пусто — счётчик не подключается.
YM_ID=

# Адрес сайта для метаданных. Домен ещё не выбран.
SITE_URL=http://localhost:3003
